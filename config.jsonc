{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "C:/Users/%USERNAME%/.config/fastfetch/ascii.txt",
    "color": {
      "1": "blue",
      "2": "cyan"
    },
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "blue"
    }
  },
  "modules": [
    "break",
    "title",
    "separator",
    "os",
    "host",
    "uptime",
    "break",
    "cpu",
    "gpu",
    "break",
    "memory",
    "disk",
    "break"
  ]
}
